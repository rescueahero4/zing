# Template only — this file IS committed. Copy it to `.env.local` and put real
# values there; `.env.local` is gitignored, this file is not.
#
#   cp .env.example .env.local

# --- Offline mock mode (no keys, no spend) ---
# Unset  → real Claude / fal / ElevenLabs (needs the keys below).
# 1      → every agent and asset call is stubbed; the full four-stage pipeline
#          still runs, including JSON extraction, Zod validation and assembly.
# chaos  → same, plus deliberate failures (a writer answering in prose, an
#          out-of-range answer key, a dead fal call, a dead ElevenLabs call) to
#          exercise the drop-and-degrade paths from ARCH §7.
ZING_MOCK=

# --- Anthropic (Extractor / Researcher / Planner / Writers / Encourager) ---
ANTHROPIC_API_KEY=

# --- fal.ai (Flux schnell, 720x1280 portrait slide images) ---
FAL_KEY=

# Art direction is a prose style-lock in lib/fal.ts (STYLE_PREFIX) — it costs no
# latency and cannot fail, and it is what ships. Set this to 1 to *also* condition
# each image on fixtures/style-reference.jpg via flux dev image-to-image.
# Leave it unset. Measured: schnell ~1.7s/image vs dev image-to-image ~2.7s, so
# the latency is affordable, but the reference leaks its subject into unrelated
# scenes (a windowsill water jar came back with the reference's sunflower in it),
# and a picture that contradicts the narration is worse than a plainer one. The
# flag is here so the finding stays re-checkable. See lib/fal.ts for the two
# alternatives that were timed and rejected outright.
ZING_IMAGE_REF=

# --- ElevenLabs (eleven_flash_v2_5, one clip per slide) ---
ELEVENLABS_API_KEY=
# Teacher voice pool, comma-separated. One is drawn at random per batch and
# every slide in that batch reuses it, so a batch always sounds like a single
# person (ARCH §2.S4) while consecutive demo runs get different teachers.
# Default pool below is Alice, Josh, Bella and George; list one id to pin the narrator.
ELEVENLABS_VOICE_IDS=Xb7hH8MSUJpSbSDYk0k2,Rsz5u2Huh1hPlPr0oxRQ,hpp4J3VqNfWAUOO0d1Us,JBFqnCBsd6RMkjVDRZzb

# --- Vercel Blob (preferred, and required on Vercel) ---
# When set, ElevenLabs mp3 bytes are pushed to Blob and the app receives plain URLs.
# When unset, /api/assets keeps the bytes in the dev server's memory and returns
# `http://<the Host you called>/api/audio/<id>` — a real URL the phone on the LAN
# can fetch, unlike a base64 `data:` URI, which iOS AVPlayer (behind expo-audio)
# does not reliably play. That store is per-process and holds only the most recent
# ~64 clips / ~32MB, so it does NOT survive a serverless cold start: set a token
# when deploying. Only if no Host header is available does it still emit a
# base64 `data:` URI (the POC path from ARCH 2.S4).
BLOB_READ_WRITE_TOKEN=
